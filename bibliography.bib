@article{truellResponse2002,
	title = {Response rate, speed, and completeness: {A} comparison of internet-based and mail surveys.},
	volume = {34},
	doi = {10.3758/BF03195422},
	abstract = {Because of their speed and accessibility, the use of on-line research tools has grown considerably in recent years. The present study compared two ways of delivering surveys: Internet-based and mail delivery methods. 306 experimental subjects were randomly assigned to receive either an Internet-based survey or a mail survey. 159 surveys were returned as usable; 78 were Internet distributed and 81 were mail distributed. Although Internet-based and mail surveys achieved a similar response rate, Internet-based surveys may be more effective than mail surveys in a setting such as when the target population has both e-mail and Internet access. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
